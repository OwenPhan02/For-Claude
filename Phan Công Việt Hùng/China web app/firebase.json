{
  "hosting": [
    {
      "site": "welcome-to-china-vn",
      "public": ".",
      "ignore": ["firebase.json", "firestore.rules", "server.mjs", "docs/**", "**/.*", "**/node_modules/**"],
      "headers": [
        { "source": "**/*.@(js|css|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    },
    {
      "site": "tu-hoc-tieng-trung-37b24",
      "public": "docs/redirect",
      "redirects": [
        { "source": "/", "destination": "https://welcome-to-china-vn.web.app/", "type": 301 },
        { "source": "/:path*", "destination": "https://welcome-to-china-vn.web.app/:path*", "type": 301 }
      ]
    }
  ],
  "firestore": { "rules": "firestore.rules" }
}
