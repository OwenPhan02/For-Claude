rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi người chỉ đọc/ghi được tiến độ của chính mình
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Bảng xếp hạng tuần: ai cũng xem được, chỉ ghi được dòng của mình
    match /leaderboard/{week}/users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp < 100000
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
    }
  }
}
